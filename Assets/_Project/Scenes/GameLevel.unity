  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Darkness. Stone. The taste of iron on your tongue.\r\n\r\nYou wake with
    no memory of how you got here. No weapons. No strength. Just ancient walls and
    a sickly green fog that burns with every breath.\r\n\r\nYour health is fading.
    The venom seeps deeper by the second.\r\n\r\nBut you are not helpless. Three
    melodies surface from deep in your memory \u2014 childhood songs your grandmother
    hummed to keep the serpents at bay.\r\n\r\nMove [1] - Compel a snake to clear
    your path.\r\nDaze [2] - Lull a serpent into sleep.\r\nShield [3] - Protect yourself
    from the next serpent's strike.\r\n\r\nSomewhere ahead, fresh air. Somewhere
    ahead, a way out.\r\n\r\nFind it \u2014 before it's too late.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0b9bc487b9b6cac4583801b20e77a751, type: 2}
  m_sharedMaterial: {fileID: 6049873288185909572, guid: 0b9bc487b9b6cac4583801b20e77a751, type: 2}
